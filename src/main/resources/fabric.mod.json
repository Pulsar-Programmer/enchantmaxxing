{
	"schemaVersion": 1,
	"id": "enchantify",
	"version": "${version}",
	"name": "Final Tinted Touch (FTT)",
	"description": "Mod that helps max out enchants on items.",
	"authors": [
		"Nosam08",
		"Subraid"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/Pulsar-Programmer/enchantmaxxing"
	},
	"license": "CC0-1.0",
	"icon": "assets/enchantmaxxing/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.nosam08.enchantmaxxing.EnchantifyClient"
		],

		"modmenu": [
			"net.nosam08.enchantmaxxing.config.EnchantifyModMenu"
		]
	},
	"mixins": [
		"enchantify.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "${minecraft_version}",
		"java": ">=21",

		"fabric-api": "${fabric_version}",
		"cloth-config": "${cloth_config}",
		"owo": ">=0.12.19+1.21.4"
	},
	"suggests": {
		"fabricloader": ">=${loader_version}",
		
		"modmenu": "${mod_menu}",
		"owo": "${owo_version}"
	}
}