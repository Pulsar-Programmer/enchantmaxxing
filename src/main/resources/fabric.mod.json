{
	"schemaVersion": 1,
	"id": "enchantify",
	"version": "${version}",
	"name": "Final Tinted Touch (FTT)",
	"description": "Mod that helps max out enchants on items.",
	"authors": [
		"Nosam08",
		"Subraid"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/Pulsar-Programmer/enchantmaxxing"
	},
	"license": "CC0-1.0",
	"icon": "assets/enchantmaxxing/icon.png",
	"environment": "client",
	"accessWidener": "enchantify.accesswidener",
	"entrypoints": {
		"client": [
			"net.nosam08.enchantmaxxing.EnchantifyClient"
		],

		"walksylib": [
			"net.nosam08.enchantmaxxing.config.EnchantifyWalksyApi"
		]
	},
	"mixins": [
		"enchantify.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": ">=26.1 <26.2",
		"java": ">=25",

		"fabric-api": ">=${fabric_version}",
		"walksylib": ">=${walksylib_version}",
		"owo": ">=${owo_version}"
	},
	"suggests": {
		"fabricloader": ">=${loader_version}",
		
		"modmenu": ">=${mod_menu}"
	}
}